# Copy this file to .env and fill in your own values.
# .env is git-ignored: never commit real keys.

# Needed only for live runs (`garden run`, `garden eval --live`).
# Offline tests and evals do not use it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional database (uv sync --extra db). Owner URL: schema and `garden db sync`.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Read-only URL the app answers with; written by `garden db create-reader`.
# DATABASE_URL_READER=

# Optional: netztransparenz.de Web API (redispatch data). Free registration at
# https://api-portal.netztransparenz.de/ -> OAuth Manager -> create a client.
# NTP_CLIENT_ID=
# NTP_CLIENT_SECRET=
